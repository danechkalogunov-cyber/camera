# Python bytecode. Scripts/ holds two checkers; importing one from a REPL or from the
# other leaves a __pycache__ beside them, and it is not ours to commit.
__pycache__/
*.pyc

# agent scratch logs
.rtpb-logs/
.*-logs/

# SwiftPM scratch path that got committed once (ed45068), untracked again in 4b5bee6. The blobs
# stay in history by decision, not by oversight — rewriting would change every SHA from the 47th
# commit on. ЗАПУСК.md, «Шаг 2», says why the clone is 110 MB and how --depth 1 avoids it.
.b/

# Claude Code's local working directory. `.claude/worktrees/` holds the isolated git worktrees
# spawned for parallel sub-agents — each is a full checkout of this repo, locked while its agent
# runs. Committing it would nest the repository inside itself; it is transient tooling, not source.
.claude/
