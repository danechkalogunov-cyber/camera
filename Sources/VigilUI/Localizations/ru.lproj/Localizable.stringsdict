<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ locked this account after too many failed sign-ins. It usually unlocks in about %lld minutes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Устройство %1$@ заблокировало эту учётную запись после нескольких неудачных попыток входа. Обычно блокировка снимается примерно через %2$#@minutes@.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%2$lld минуты</string>
			<key>many</key>
			<string>%2$lld минут</string>
			<key>one</key>
			<string>%2$lld минуту</string>
			<key>other</key>
			<string>%2$lld минуты</string>
		</dict>
	</dict>
	<key>%lld events</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@events@</string>
		<key>events</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld события</string>
			<key>many</key>
			<string>%lld событий</string>
			<key>one</key>
			<string>%lld событие</string>
			<key>other</key>
			<string>%lld события</string>
		</dict>
	</dict>
	<key>%lld frames waiting to decode — video may lag.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@frames@</string>
		<key>frames</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld кадра ожидают декодирования — видео может запаздывать.</string>
			<key>many</key>
			<string>%lld кадров ожидают декодирования — видео может запаздывать.</string>
			<key>one</key>
			<string>%lld кадр ожидает декодирования — видео может запаздывать.</string>
			<key>other</key>
			<string>%lld кадра ожидают декодирования — видео может запаздывать.</string>
		</dict>
	</dict>
	<key>Vigil stopped signing in to %@ so the camera's account cannot be locked out. It will try again in about %lld minutes. Nothing is wrong with the camera.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vigil приостановил попытки входа на %1$@, чтобы не заблокировать учётную запись камеры. Следующая попытка примерно через %2$#@minutes@. С камерой всё в порядке.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%2$lld минуты</string>
			<key>many</key>
			<string>%2$lld минут</string>
			<key>one</key>
			<string>%2$lld минуту</string>
			<key>other</key>
			<string>%2$lld минуты</string>
		</dict>
	</dict>
	<key>NVR · %lld channels online, %lld empty</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>NVR · %1$#@online@, %2$#@empty@</string>
		<key>online</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld канал онлайн</string>
			<key>few</key>
			<string>%1$lld канала онлайн</string>
			<key>many</key>
			<string>%1$lld каналов онлайн</string>
			<key>other</key>
			<string>%1$lld канала онлайн</string>
		</dict>
		<key>empty</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld пустой</string>
			<key>few</key>
			<string>%2$lld пустых</string>
			<key>many</key>
			<string>%2$lld пустых</string>
			<key>other</key>
			<string>%2$lld пустого</string>
		</dict>
	</dict>
</dict>
</plist>
