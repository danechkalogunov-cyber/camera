/*
  Localizable.strings (ru)
  VigilUI — русская локализация.

  Ключ — это английский текст, поэтому пропущенный ключ показывает корректный английский,
  а ключ с опечаткой молча показывает английский вместо русского. Порядок ключей и разбивка
  на разделы совпадают с en.lproj.

  Терминология зафиксирована глоссарием docs/UX.md §14.5 и не меняется от строки к строке.
  Тон: спокойный, в настоящем времени, без восклицательных знаков и без извинений
  (docs/UX.md §14.1). Русский текст на 20–35 % длиннее английского — это учтено в вёрстке
  (форма подключения имеет фиксированную ширину 420 pt).

  75 ключей. Строки с числами — в Localizable.stringsdict: в русском три формы
  множественного числа (one / few / many) плюс other, и в плоском .strings их не выразить.

  Спецификаторы формата (%@, %lld) входят в состав ключа и в значении могут быть
  позиционными (%1$@, %2$lld), если порядок слов в русском другой. Внутри одного значения
  позиционные и непозиционные спецификаторы смешивать нельзя.
*/

/* Форма подключения — первый экран (UX.md §8.3) */
"Connect to a camera" = "Подключение к камере";
"Vigil needs the camera's address and the password it was set up with. Nothing leaves your network." = "Укажите адрес камеры и пароль, который был задан при её настройке. Ничего не покидает вашу сеть.";
"Address" = "Адрес";
"User name" = "Имя пользователя";
"Password" = "Пароль";
"The camera's password" = "Пароль камеры";
"Connect" = "Подключиться";
"192.168.1.64" = "192.168.1.64";
"admin" = "admin";

/* Проверка полей. Строка одна (lineLimit(1)), Caption1, около 380 pt — держите короткой */
"Enter the camera's address." = "Введите адрес камеры.";
"Use an IP address like 192.168.1.64, or a host name." = "Укажите IP-адрес (например, 192.168.1.64) или имя узла.";

/* Самая длинная подсказка в форме. Строка одна (lineLimit(1)), ширина около 380 pt,
   поэтому перевод сокращён сознательно, а не переведён буквально. */
"Enter the account name. Hikvision cameras use admin unless it was changed." = "Введите имя пользователя. На камерах Hikvision это обычно admin.";
"Enter the camera's password." = "Введите пароль камеры.";

/* Заголовки диагнозов: факт, не более шести слов, с точкой в конце */
"Can't reach this camera." = "Камера недоступна.";
"Camera isn't activated." = "Камера не активирована.";
"Wrong password." = "Неверный пароль.";
"Device is locked." = "Устройство заблокировано.";
"Video port is closed." = "Порт видеопотока закрыт.";
"Not a Hikvision device." = "Это не устройство Hikvision.";
"Unsupported video format." = "Формат видео не поддерживается.";
"No video is arriving." = "Видео не поступает.";
"The picture has stalled." = "Изображение застыло.";
"Vigil couldn't finish signing in." = "Vigil не смог выполнить вход.";

/* Диагнозы: причина и следующий шаг. R1.5 — никогда код ошибки и никогда тупик */
"No response from %@. Check that it's powered on and on the same network as this Mac." = "Нет ответа от %@. Проверьте, включена ли камера и находится ли она в той же сети, что и этот Mac.";
"%@ is brand new and has no password yet. Set one now to start using it." = "%@ — новое устройство, пароль ещё не задан. Задайте его, чтобы начать работу.";
"%@ rejected this password. Check it and try again — too many attempts will lock the device." = "Устройство %@ отклонило этот пароль. Проверьте пароль и попробуйте снова — после нескольких неудачных попыток камера заблокирует учётную запись.";
"%@ locked this account after too many failed sign-ins. It unlocks on its own, or immediately if you reboot the camera." = "Устройство %@ заблокировало эту учётную запись после нескольких неудачных попыток входа. Блокировка снимется сама или сразу после перезагрузки камеры.";
"Vigil reached %@ on port %lld, but RTSP port %lld refused the connection." = "Vigil связался с %1$@ по порту %2$lld, но порт RTSP %3$lld отклонил подключение.";
"%@ answered, but it doesn't speak ISAPI. Vigil can still try ONVIF, with fewer features." = "Устройство %@ ответило, но не поддерживает ISAPI. Vigil может подключиться по ONVIF — с меньшим набором функций.";
"This camera streams %@. Vigil plays H.265, H.264 and MJPEG." = "Камера передаёт %@. Vigil воспроизводит H.265, H.264 и MJPEG.";
"%@ started the stream but sent no video. Something on the network is blocking UDP." = "Устройство %@ запустило поток, но не отправило видео. Что-то в сети блокирует UDP.";
"%@ is sending data but no complete picture yet. Vigil has asked it for a new keyframe." = "Устройство %@ передаёт данные, но полного изображения пока нет. Vigil запросил новый ключевой кадр.";
"%@ answered, but not in a way Vigil recognises. The device's own reply is in the details below." = "Устройство %@ ответило, но Vigil не распознал ответ. Дословный ответ устройства — в подробностях ниже.";

/* Действия. У каждой неудачи есть хотя бы одно (R1.5) */
"Try Again" = "Повторить";
"Check the Address" = "Проверить адрес";
"Update Password" = "Изменить пароль";
"Set Password" = "Задать пароль";
"Try Port 8554" = "Попробовать порт 8554";
"Switch to TCP" = "Переключиться на TCP";
"Use ONVIF" = "Использовать ONVIF";
"Open Camera Web Page" = "Открыть веб-интерфейс камеры";
"Diagnose" = "Диагностика";
"Details" = "Подробности";

/* Слово состояния рядом с точкой. Цвет никогда не единственный носитель (DESIGN.md §10.5) */
"Connecting" = "Подключение";
"Live" = "Прямой эфир";
"Degraded" = "Нестабильно";
"Offline" = "Не в сети";

/* Пояснения на время подключения (UX.md §12.4) */
"Looking up %@…" = "Поиск %@…";
"Connecting…" = "Подключение…";
"Signing in…" = "Проверка пароля…";
"Negotiating stream…" = "Согласование потока…";
"Opening video channel…" = "Открытие видеоканала…";
"Waiting for video…" = "Ожидание видео…";
"Waiting for a keyframe…" = "Ожидание ключевого кадра…";

/* Измеренные проблемы. Число приходит из FormatStyle уже локализованным */
/* Число приходит уже отформатированным (FormatStyle): в русском «3,1 %» с пробелом
   перед знаком (UX.md §14.1, п. 9). Знак процента в значение не добавлять. */
"%@ packet loss — video may stutter." = "Потеря пакетов %@ — возможны рывки видео.";
"%@ of jitter — video may stutter." = "Джиттер %@ — возможны рывки видео.";

/* Оба числа приходят строками (%@), поэтому правило множественного числа к ним
   применить нельзя. Отсюда неизменяемая единица «кадр/с» вместо согласуемого
   существительного. */
"Showing %@ of %@ frames per second." = "Частота кадров: %1$@ из %2$@ кадр/с.";
"Switched to TCP for stability." = "Переключено на TCP для стабильности.";

/* Нет связи и повторное подключение (UX.md §12.6) */
"Still can't reach this camera." = "Камера по-прежнему недоступна.";
"Connection lost." = "Соединение потеряно.";
"Waiting for the network." = "Ожидание сети.";

/* Строка с числами, но множественное число здесь не нужно: «с» — сокращение, а
   «попытка 3» — подпись, и ни то, ни другое с числом не согласуется. Перенос в
   stringsdict привёл бы к неверному «попытки 3». */
"Reconnecting in %lld s (attempt %lld)." = "Повторное подключение через %1$lld с (попытка %2$lld).";
"Retry Now" = "Повторить сейчас";

/* Метка времени бывает относительной («4 мин. назад») и абсолютной («10:14»), и
   фраза должна читаться с обеими. Поэтому двоеточие, а не предлог. */
"Last seen %@" = "Последний кадр: %@";

/* Оверлей подключения */
/* Здесь подставляется имя камеры. По UX.md §14.2 имя берётся в кавычки языка —
   «ёлочки» стоят в переводе, а не в коде, и имя остаётся в именительном падеже. */
"Connecting to %@" = "Подключение к камере «%@»";

/* Единица измерения входит в ключ. По ГОСТ 8.417 секунда — «с», без точки. */
"%@ s" = "%@ с";
"This is taking longer than usual." = "Это занимает больше времени, чем обычно.";

/* Компоненты */
"Hide password" = "Скрыть пароль";
"Show password" = "Показать пароль";
"Loading" = "Загрузка";

/* Пока встречаются только в превью #if DEBUG. В docs/UX.md §14.3–§14.4 первые три
   значатся как рабочий текст интерфейса, поэтому переведены заранее. */
"Add Manually" = "Добавить вручную";
"Delete Camera" = "Удалить камеру";
"Snapshot" = "Снимок";
"Required" = "Обязательно";

/* Диагноз signInPaused: решение принято в docs/RULING-LOCKOUT.md §3, в коде его пока
   нет. Формулировка взята из решения. До появления кейса ключ не используется. */
"Waiting before trying again" = "Ожидание перед следующей попыткой";

/* Сцена — сетка плиток (UX.md §5.1, §5.4). Сцена озвучивается как контейнер: каждая
   плитка внутри называет свою камеру сама, поэтому здесь достаточно назвать контейнер. */
"Camera grid" = "Сетка камер";

/* Чип «+3» в правом нижнем углу сцены: камеры, которые не поместились в раскладку.
   Видимый текст — только число, поэтому правило множественного числа не нужно и оба
   ключа остаются в .strings, а не в .stringsdict. */
"Cameras that don't fit this layout" = "Камеры, которые не помещаются в эту раскладку";
"Show the cameras that don't fit" = "Показать камеры, которые не поместились";

/* ── Боковая панель (UX.md §4, DESIGN.md §9.12) ────────────────────────────────────── */

/* Четыре постоянных заголовка разделов. Caption2 переводит их в верхний регистр, поэтому
   здесь и в переводе они записаны обычным регистром. Ключ `Live` уже есть выше — это то
   же слово о том же самом, и один ключ обслуживает оба места. */
"Groups" = "Группы";
"Cameras" = "Камеры";
"Library" = "Библиотека";

/* Единственная строка раздела LIVE и три ссылки раздела LIBRARY */
"Current Layout" = "Текущая раскладка";
"Recordings" = "Записи";
"Events" = "События";
"Bookmarks" = "Закладки";

/* Приглушённая строка, которую раздел показывает вместо того, чтобы исчезнуть
   (UX.md §4.1, §12.2). У раздела CAMERAS их две, и они не взаимозаменяемы: пустая
   библиотека предлагает добавить камеру, а безрезультатный поиск — отменить себя. */
"No groups — drag cameras together to make one" = "Групп пока нет — перетащите камеры друг на друга";
"No cameras yet" = "Камер пока нет";
"No cameras match your search" = "Ничего не найдено";
"Clear Filters" = "Сбросить фильтры";

/* Подписи VoiceOver для кнопок без текста: два «плюса» в заголовках разделов и шестерёнка
   в подвале. Глиф не произносится, и две видимые кнопки в одном окне не могут иметь
   одинаковую подпись (DESIGN.md §10.7). */
"New Group" = "Новая группа";
"Add Camera" = "Добавить камеру";
"Settings" = "Настройки";

/* Подвал состояния, «6 в эфире · 1,8 Гбит/с» (UX.md §3.3). Число и слово — отдельные
   фрагменты Text, поэтому пара никогда не становится согласуемым числительным и не
   требует stringsdict; оба русских значения подобраны неизменяемыми именно для этого. */
"live" = "в эфире";
"degraded" = "с проблемами";

/* Строка состояния камеры (UX.md §4.2, §12.5, §12.6). Числа приходят уже отформатированными
   из FormatStyle, поэтому в значении стоит голый %@ — без разделителя и без знака процента.
   «Connecting…», «Offline» и «Live» переиспользуются из разделов выше. */
"Disabled" = "Отключена";
"Sign-in failed" = "Ошибка входа";
"Offline · retry %@ s" = "Не в сети · повтор через %@ с";
"Connecting %@" = "Подключение %@";
"%@ loss" = "потери %@";
"%@ jitter" = "джиттер %@";
"%@ queued" = "в очереди %@";
"%@ fps" = "%@ кадр/с";
"On TCP" = "По TCP";

/* Единица измерения входит в ключ — так же, как в «%@ s» выше: у Measurement сокращение
   секунды — «sec», а у битрейта Measurement нет вовсе. По ГОСТ 8.417 — «бит/с». */
"%@ b/s" = "%@ бит/с";
"%@ kb/s" = "%@ кбит/с";
"%@ Mb/s" = "%@ Мбит/с";
"%@ Gb/s" = "%@ Гбит/с";

/* Всплывающая подсказка у маркера дополнительного потока в строке камеры (UX.md §4.2) */
"Sub-stream" = "Дополнительный поток";
