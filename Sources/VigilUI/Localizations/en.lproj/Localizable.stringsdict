<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ locked this account after too many failed sign-ins. It usually unlocks in about %lld minutes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ locked this account after too many failed sign-ins. It usually unlocks in about %2$#@minutes@.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld minute</string>
			<key>other</key>
			<string>%2$lld minutes</string>
		</dict>
	</dict>
	<key>%lld events</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@events@</string>
		<key>events</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld event</string>
			<key>other</key>
			<string>%lld events</string>
		</dict>
	</dict>
	<key>%lld frames waiting to decode — video may lag.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@frames@</string>
		<key>frames</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld frame waiting to decode — video may lag.</string>
			<key>other</key>
			<string>%lld frames waiting to decode — video may lag.</string>
		</dict>
	</dict>
	<key>Vigil stopped signing in to %@ so the camera's account cannot be locked out. It will try again in about %lld minutes. Nothing is wrong with the camera.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Vigil stopped signing in to %1$@ so the camera's account cannot be locked out. It will try again in about %2$#@minutes@. Nothing is wrong with the camera.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld minute</string>
			<key>other</key>
			<string>%2$lld minutes</string>
		</dict>
	</dict>
	<key>NVR · %lld channels online, %lld empty</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>NVR · %1$#@online@, %2$#@empty@</string>
		<key>online</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld channel online</string>
			<key>other</key>
			<string>%1$lld channels online</string>
		</dict>
		<key>empty</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld empty</string>
			<key>other</key>
			<string>%2$lld empty</string>
		</dict>
	</dict>
</dict>
</plist>
